# Скопіюйте у web/.env.local і заповніть (це ПУБЛІЧНІ ідентифікатори Firebase, не секрети).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_REGION=europe-west1
# reCAPTCHA Enterprise site key для App Check
VITE_RECAPTCHA_SITE_KEY=
# true → підключатися до Firebase Emulator Suite
VITE_USE_EMULATORS=false
VITE_DEMO=false
