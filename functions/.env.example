# Параметри (НЕ секрети) для функцій. Скопіюйте у functions/.env.<project-id> і заповніть.
# Секрети задаються лише командою: firebase functions:secrets:set NAME

# Адреса API (Firebase Hosting на піддомені): callback- і hook-адреси платформ
PUBLIC_BASE_URL=https://api.kdstatsforme.pp.ua
# Адреса сайту (GitHub Pages): куди повертати користувача після підключення, посилання в листах
SITE_URL=https://kdstatsforme.pp.ua
KMS_KEY_NAME=projects/[FIREBASE_PROJECT]/locations/europe-west1/keyRings/knb-stats/cryptoKeys/tokens
ADMIN_EMAIL=testfortest111111@gmail.com
TELEGRAM_BOT_USERNAME=[BOT_USERNAME]
META_LOGIN_CONFIG_ID=[META_LOGIN_CONFIG_ID]
